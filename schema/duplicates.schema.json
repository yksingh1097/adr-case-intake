{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Duplicate groups across the document set",
  "type": "object",
  "required": ["groups"],
  "additionalProperties": false,
  "properties": {
    "groups": {
      "type": "array",
      "description": "Each group lists the document ids that describe the same case (same patient, same drug, same reaction). Documents in no group are not listed.",
      "items": {
        "type": "object",
        "required": ["document_ids"],
        "properties": {
          "document_ids": {"type": "array", "minItems": 2, "items": {"type": "string"}},
          "confidence": {"enum": ["high", "medium", "low"]},
          "reason": {"type": "string"}
        }
      }
    }
  }
}
